#!/usr/bin/env sh
# 提交前检查：八个检查器全部通过才允许提交（AGENTS.md 3.5、3.6、5bis.1、7bis）
# 每个克隆需自行启用：git config core.hooksPath .githooks
set -u
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

run_check() {
  label=$1
  shift
  echo "[pre-commit] 运行 $label"
  if ! "$@"; then
    echo "[pre-commit] 阻断：$label 未通过，提交已取消。" >&2
    exit 1
  fi
}

run_check "scripts/check_no_raw_material.py" python3 scripts/check_no_raw_material.py
run_check "scripts/check_anchors.py" python3 scripts/check_anchors.py
run_check "scripts/check_ledger_landings.py" python3 scripts/check_ledger_landings.py
run_check "scripts/check_gap_ledger.py --staged" python3 scripts/check_gap_ledger.py --staged
run_check "scripts/check_three_table.py" python3 scripts/check_three_table.py
run_check "scripts/check_coverage_gate.py" python3 scripts/check_coverage_gate.py
run_check "scripts/check_glossary_usage.py" python3 scripts/check_glossary_usage.py
run_check "scripts/check_state.py" python3 scripts/check_state.py

echo "[pre-commit] 八个检查器全部通过。"
