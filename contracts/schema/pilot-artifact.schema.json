{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-management-grounding/contracts/schema/pilot-artifact.schema.json",
  "title": "试点检查单投影（spec/pilot/pilot-artifact.json）",
  "description": "M3 试点产出的检查单投影样例。非执行结果，authoritative 必须为 false。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "authoritative",
    "generated",
    "source_commit",
    "checklist_source_commit",
    "not_execution_result",
    "clauses",
    "aggregate"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "authoritative": {
      "type": "boolean",
      "const": false
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "maxLength": 10
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "maxLength": 40
    },
    "checklist_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "maxLength": 40
    },
    "not_execution_result": {
      "type": "boolean",
      "const": true
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "rule",
          "severity",
          "rule_status",
          "clause",
          "verdict",
          "reason"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "maxLength": 120
          },
          "rule": {
            "type": "string",
            "pattern": "^G-[A-G]\\d$",
            "maxLength": 10
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "warn",
              "advisory"
            ],
            "maxLength": 16
          },
          "rule_status": {
            "type": "string",
            "enum": [
              "active",
              "assumption",
              "pending_reanchor"
            ],
            "maxLength": 24
          },
          "clause": {
            "type": "string",
            "maxLength": 120
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "cannot_evaluate",
              "not_applicable"
            ],
            "maxLength": 24
          },
          "reason": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "order_independent",
        "precedence"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "cannot_evaluate",
            "not_applicable"
          ],
          "maxLength": 24
        },
        "order_independent": {
          "type": "boolean"
        },
        "precedence": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "fail",
              "cannot_evaluate",
              "pass",
              "not_applicable"
            ],
            "maxLength": 24
          }
        }
      }
    }
  }
}
