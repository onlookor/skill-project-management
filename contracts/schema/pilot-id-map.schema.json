{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-management-grounding/contracts/schema/pilot-id-map.schema.json",
  "title": "试点 ID 映射（spec/pilot/pilot-id-map.json）",
  "description": "M3 试点的草稿 ID、候选 IRI 与规则绑定映射。D4 未定，formal_id 一律为 null。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authoritative", "purpose", "batch", "generated", "d4_status",
    "formal_id_status", "notes", "entries", "reverse_index",
    "rule_bindings", "reverse_rule_index", "statistics", "grounding_ref_semantics"
  ],
  "x-prose-fields": ["purpose", "grounding_ref_semantics", "notes"],
  "properties": {
    "authoritative": {"type": "boolean", "const": false},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 800},
    "batch": {"type": "string", "maxLength": 80},
    "generated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "d4_status": {"type": "string", "maxLength": 80},
    "formal_id_status": {"type": "string", "maxLength": 80},
    "notes": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draft_id", "knowledge_ref", "entry_type", "term", "candidate_iri",
          "candidate_iri_status", "candidate_iri_reason", "natural_key",
          "formal_id", "formal_id_status"
        ],
        "properties": {
          "draft_id": {"type": "string", "maxLength": 120},
          "knowledge_ref": {"type": "string", "maxLength": 160},
          "entry_type": {"type": "string", "maxLength": 80},
          "term": {"type": "string", "minLength": 1, "maxLength": 120},
          "candidate_iri": {"type": ["string", "null"], "maxLength": 200},
          "candidate_iri_status": {"type": "string", "maxLength": 80},
          "candidate_iri_reason": {"type": ["string", "null"], "maxLength": 400},
          "natural_key": {"type": "string", "maxLength": 160},
          "formal_id": {"type": ["string", "null"], "maxLength": 160},
          "formal_id_status": {"type": "string", "maxLength": 80}
        }
      }
    },
    "reverse_index": {
      "type": "object",
      "maxProperties": 60,
      "additionalProperties": {"type": "string", "maxLength": 120}
    },
    "rule_bindings": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries", "direction", "status", "note"],
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "maxLength": 160}
          },
          "direction": {"type": "string", "enum": ["bidirectional", "forward", "backward"]},
          "status": {"type": "string", "maxLength": 80},
          "note": {"type": "string", "maxLength": 800}
        }
      }
    },
    "reverse_rule_index": {
      "type": "object",
      "maxProperties": 60,
      "additionalProperties": {
        "type": "array",
        "maxItems": 20,
        "items": {"type": "string", "maxLength": 120}
      }
    },
    "statistics": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 10000}
    },
    "grounding_ref_semantics": {"type": "string", "minLength": 1, "maxLength": 600}
  }
}
