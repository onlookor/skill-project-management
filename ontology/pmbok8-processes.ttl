<https://example.org/pm/ontology/pmbok8> a owl:Ontology .

pm:fa_Closing a pm:FocusArea ;
    skos:definition "The focus area in which the work is concluded, accepted and handed over."@en ;
    skos:prefLabel "Closing"@en,
        "收尾"@zh .

pm:fa_Initiating a pm:FocusArea ;
    skos:definition "The focus area in which the work is authorized and initially framed."@en ;
    skos:prefLabel "Initiating"@en,
        "启动"@zh .

pm:dom_Schedule a pm:PerformanceDomain ;
    skos:definition "The domain that covers timing, sequencing and delivery dates."@en ;
    skos:prefLabel "Schedule"@en,
        "进度"@zh .

pm:dom_Finance a pm:PerformanceDomain ;
    skos:definition "The domain that covers funding, cost and financial performance."@en ;
    skos:prefLabel "Finance"@en,
        "财务"@zh .

pm:dom_Resources a pm:PerformanceDomain ;
    skos:definition "The domain that covers people, capacity and other means of doing the work."@en ;
    skos:prefLabel "Resources"@en,
        "资源"@zh .

pm:dom_Risk a pm:PerformanceDomain ;
    skos:definition "The domain that covers uncertainty and its treatment."@en ;
    skos:prefLabel "Risk"@en,
        "风险"@zh .

pm:dom_Scope a pm:PerformanceDomain ;
    skos:definition "The domain that covers what the work must and must not include."@en ;
    skos:prefLabel "Scope"@en,
        "范围"@zh .

pm:dom_Stakeholders a pm:PerformanceDomain ;
    skos:definition "The domain that covers engagement, communication and expectations."@en ;
    skos:prefLabel "Stakeholders"@en,
        "相关方"@zh .

pm:fa_Executing a pm:FocusArea ;
    skos:definition "The focus area in which the planned work is carried out."@en ;
    skos:prefLabel "Executing"@en,
        "执行"@zh .

pm:dom_Governance a pm:PerformanceDomain ;
    skos:definition "The domain that covers authorization, direction and oversight of the work."@en ;
    skos:prefLabel "Governance"@en,
        "治理"@zh .

pm:fa_MonitoringAndControlling a pm:FocusArea ;
    skos:definition "The focus area in which performance is compared with plans and corrected."@en ;
    skos:prefLabel "Monitoring and Controlling"@en,
        "监控"@zh .

pm:fa_Planning a pm:FocusArea ;
    skos:definition "The focus area in which approach, scope, timing and controls are defined."@en ;
    skos:prefLabel "Planning"@en,
        "规划"@zh .

