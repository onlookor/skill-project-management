{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime/artifacts/audit-trail.schema.json",
  "title": "审计留痕工件（CAP-42）",
  "description": "每次判定的输入指纹、规则版本、结论、时间、执行者与证据路径。记录必须首尾相接形成摘要链：`prev_digest` 等于上一条记录的规范化摘要；非首次记录从 `genesis` 起链。链断或序号非严格递增由 `audit.chain_digest` / `audit.sequence_strict` 判违规。",
  "x-checks": [
    "audit.required_fields",
    "audit.chain_digest",
    "audit.sequence_strict",
    "audit.exit_code_valid",
    "audit.evidence_present"
  ],
  "x-provenance": {
    "requires": [
      "audit.runs",
      "audit.artifacts"
    ],
    "$comment": "留痕只能转录真实运行的输入指纹与结论；不得事后补写未发生的运行。"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "project_id",
    "config_ref",
    "provenance",
    "data"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "audit-trail",
      "maxLength": 40
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 16
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_digest",
        "item_digests"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "config.schema/1",
          "maxLength": 40
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 72
        },
        "item_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          }
        },
        "defaulted": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^(CFG-10|CFG-11)$",
            "maxLength": 8
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records"
      ],
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "run_id",
              "ts",
              "actor",
              "artifact_type",
              "artifact_digest",
              "config_digest",
              "rule_version",
              "checks_run",
              "exit_code",
              "evidence_paths",
              "prev_digest"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "run_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "maxLength": 64
              },
              "ts": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T[0-9:+-]{5,24}$",
                "maxLength": 32
              },
              "actor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "artifact_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "artifact_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 72
              },
              "config_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 72
              },
              "rule_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "checks_run": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "exit_code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "evidence_paths": {
                "type": "array",
                "minItems": 0,
                "maxItems": 40,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "prev_digest": {
                "type": "string",
                "pattern": "^(genesis|sha256:[0-9a-f]{64})$",
                "maxLength": 72
              }
            }
          }
        }
      }
    }
  }
}
