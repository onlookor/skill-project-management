{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime/artifacts/cost-budget.schema.json",
  "title": "预算基线工件（CAP-19）",
  "description": "工作包预算按成本科目与 WBS 双向汇总，并要求分时段金额之和等于工作包总额。成本科目表来自 CFG-15、货币来自 CFG-09：工件只引用编码，不复制科目表，避免两套口径。",
  "x-checks": [
    "budget.accounts_registered",
    "budget.package_unique",
    "budget.total_conserved",
    "budget.time_phased_sum",
    "budget.currency_match"
  ],
  "x-provenance": {
    "requires": [
      "budget.work_packages",
      "budget.periods"
    ],
    "$comment": "金额与时段必须指回估算输入；不得由解释器或模型自行生成数值。"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "project_id",
    "config_ref",
    "provenance",
    "data"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "cost-budget",
      "maxLength": 40
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 16
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_digest",
        "item_digests"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "config.schema/1",
          "maxLength": 40
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 72
        },
        "item_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          }
        },
        "defaulted": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^(CFG-10|CFG-11)$",
            "maxLength": 8
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "work_packages"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 3
        },
        "work_packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "wbs_ref",
              "account_code",
              "amount"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$",
                "maxLength": 32
              },
              "wbs_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$",
                "maxLength": 32
              },
              "account_code": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9._-]{0,31}$",
                "maxLength": 32
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "periods": {
                "type": "array",
                "maxItems": 240,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "period",
                    "amount"
                  ],
                  "properties": {
                    "period": {
                      "type": "string",
                      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                      "maxLength": 7
                    },
                    "amount": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000000000
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
