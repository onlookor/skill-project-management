{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime/artifacts/deviation-report.schema.json",
  "title": "偏差分档报告工件（CAP-16）",
  "description": "偏差值由工件给出的 PV/EV/AC 复算，档位由 CFG-03.metric 与 CFG-03.boundaries 决定，标签必须落在 CFG-02.labels 内。分档维度由 CFG-01 决定：要求 cost_account 时 work_packages 非空，要求 wbs_node 时条目必须有 wbs_ref。本 schema 只约束形状，分档一致性由 `x-checks` 绑定检查执行。",
  "x-checks": [
    "deviation.thresholds_configured",
    "deviation.dimensions",
    "deviation.custom_metric",
    "deviation.band_consistent"
  ],
  "x-provenance": {
    "requires": [
      "deviation.work_packages",
      "deviation.measurements"
    ],
    "$comment": "偏差点必须指回工作包与测量来源；档位标签是配置映射的结果，不得由模型改写。"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "project_id",
    "config_ref",
    "provenance",
    "data"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "deviation-report",
      "maxLength": 40
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 16
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_digest",
        "item_digests"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "config.schema/1",
          "maxLength": 40
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 72
        },
        "item_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          }
        },
        "defaulted": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^(CFG-10|CFG-11)$",
            "maxLength": 8
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "points",
        "work_packages"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "SPI",
            "CPI",
            "custom"
          ],
          "maxLength": 8
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "pv",
              "ev",
              "ac",
              "band"
            ],
            "properties": {
              "period": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}$",
                "maxLength": 7
              },
              "pv": {
                "type": "number",
                "minimum": 0
              },
              "ev": {
                "type": "number",
                "minimum": 0
              },
              "ac": {
                "type": "number",
                "minimum": 0
              },
              "band": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              }
            }
          }
        },
        "work_packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "wbs_ref",
              "account_code"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$",
                "maxLength": 32
              },
              "wbs_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "account_code": {
                "type": "string",
                "pattern": "^[0-9]{4}$",
                "maxLength": 4
              }
            }
          }
        }
      }
    }
  }
}
