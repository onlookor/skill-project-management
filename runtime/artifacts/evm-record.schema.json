{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime/artifacts/evm-record.schema.json",
  "title": "挣值记录工件（CAP-20）",
  "description": "PV/EV/AC 序列与预测。挣值计量规则由 CFG-13 决定，舍入口径由 CFG-10 决定；EAC 三法不得由实现默认选一，必须由工件显式写明 `eac_method`，缺失即无法判定。`evm.formulas` 绑定检查逐期复算 SV/CV/SPI/CPI 与所选 EAC，与工件自报值不符即判违规。",
  "x-checks": [
    "evm.formulas",
    "evm.ev_measurement",
    "evm.eac_method",
    "evm.budget_consistent",
    "evm.term_aliases"
  ],
  "x-provenance": {
    "requires": [
      "evm.baseline",
      "evm.actuals"
    ],
    "$comment": "BAC 与各期 PV/EV/AC 必须指回预算基线与实际数据；预测值只能由公式从这些输入算出。"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "project_id",
    "config_ref",
    "provenance",
    "data"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "evm-record",
      "maxLength": 40
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 16
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_digest",
        "item_digests"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "config.schema/1",
          "maxLength": 40
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 72
        },
        "item_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          }
        },
        "defaulted": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^(CFG-10|CFG-11)$",
            "maxLength": 8
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bac",
        "eac_method",
        "measurements",
        "work_packages"
      ],
      "properties": {
        "bac": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "eac_method": {
          "type": "string",
          "enum": [
            "cpi",
            "cpi_spi",
            "atypical"
          ],
          "maxLength": 16
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 240,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "pv",
              "ev",
              "ac"
            ],
            "properties": {
              "period": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "maxLength": 7
              },
              "pv": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "ev": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "ac": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              }
            }
          }
        },
        "work_packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "budget",
              "status",
              "percent_complete"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$",
                "maxLength": 32
              },
              "budget": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "in_progress",
                  "complete"
                ],
                "maxLength": 16
              },
              "percent_complete": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  }
}
