{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime/artifacts/status-snapshot.schema.json",
  "title": "状态快照工件（CAP-35）",
  "description": "状态采集的字典与样本。数据字典字段是判据（采什么、单位、来源、采集时刻），采样时点由 CFG-04/05/06/07/08 在求值时计算。缺数必须显式写 `value: null` 加 `unavailable_reason`，不得以 0 或空值代替：`status.no_implicit_zero` 绑定检查会把未说明的缺数判为无法判定，而不是通过。",
  "x-checks": [
    "status.dictionary_fields",
    "status.no_implicit_zero",
    "status.sample_grid",
    "status.account_registered"
  ],
  "x-provenance": {
    "requires": [
      "status.sources",
      "status.dictionary"
    ],
    "$comment": "每条测量必须能指回采集来源；来源字段为空即视为无源生成。"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "project_id",
    "config_ref",
    "provenance",
    "data"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "status-snapshot",
      "maxLength": 40
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 16
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_digest",
        "item_digests"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "config.schema/1",
          "maxLength": 40
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 72
        },
        "item_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          }
        },
        "defaulted": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^(CFG-10|CFG-11)$",
            "maxLength": 8
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "dictionary",
        "samples"
      ],
      "properties": {
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "maxLength": 10
            },
            "end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "maxLength": 10
            }
          }
        },
        "dictionary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "unit",
              "source",
              "collected_at"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^(PV|EV|AC|percent_complete|actual_hours|earned_hours|planned_hours)$",
                "maxLength": 32
              },
              "unit": {
                "type": "string",
                "enum": [
                  "currency",
                  "hour",
                  "percent",
                  "count"
                ],
                "maxLength": 16
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "collected_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T[0-9:+-]{5,20}$",
                "maxLength": 32
              }
            }
          }
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "at",
              "measurements"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S-[A-Za-z0-9._-]{1,30}$",
                "maxLength": 32
              },
              "at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T[0-9:+-]{5,20}$",
                "maxLength": 32
              },
              "measurements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "account_code",
                    "metric"
                  ],
                  "properties": {
                    "account_code": {
                      "type": "string",
                      "pattern": "^[A-Z0-9][A-Z0-9._-]{0,31}$",
                      "maxLength": 32
                    },
                    "metric": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "unavailable_reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
